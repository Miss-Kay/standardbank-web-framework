{
  "name": "standardbank-web-framework",
  "version": "1.0.0",
  "description": "Standard Bank web journey + link integrity framework — Playwright + TypeScript, self-healing locators, CI/CD to AWS",
  "scripts": {
    "test": "playwright test",
    "test:links": "playwright test tests/wealth-link-integrity.spec.ts",
    "test:journey": "playwright test --grep @journey",
    "test:headed": "playwright test --headed --project=chromium",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "baseline:update": "UPDATE_BASELINE=1 playwright test tests/wealth-link-integrity.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  }
}
